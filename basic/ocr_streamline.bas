390 IF DROP = 1 THEN PRINT "PASS: hline_gap": GOTO 410
400 PRINT "FAIL: hline_gap": FAILS = FAILS + 1
410 L$ = "____": GOSUB 10000
420 IF DROP = 1 THEN PRINT "PASS: under": GOTO 440
430 PRINT "FAIL: under": FAILS = FAILS + 1
440 L$ = "====": GOSUB 10000
450 IF DROP = 1 THEN PRINT "PASS: eqline": GOTO 470
460 PRINT "FAIL: eqline": FAILS = FAILS + 1
470 L$ = "++++": GOSUB 10000
480 IF DROP = 1 THEN PRINT "PASS: plusline": GOTO 500
490 PRINT "FAIL: plusline": FAILS = FAILS + 1
500 L$ = "~~~~": GOSUB 10000
510 IF DROP = 1 THEN PRINT "PASS: tilde": GOTO 530
520 PRINT "FAIL: tilde": FAILS = FAILS + 1
530 L$ = "()": GOSUB 10000
540 IF DROP = 1 THEN PRINT "PASS: circle_mark": GOTO 560
550 PRINT "FAIL: circle_mark": FAILS = FAILS + 1
560 L$ = "( )": GOSUB 10000
570 IF DROP = 1 THEN PRINT "PASS: circle_gap": GOTO 590
580 PRINT "FAIL: circle_gap": FAILS = FAILS + 1
590 L$ = "^": GOSUB 10000
600 IF DROP = 1 THEN PRINT "PASS: tri_mark": GOTO 620
610 PRINT "FAIL: tri_mark": FAILS = FAILS + 1
620 L$ = "/\": GOSUB 10000
630 IF DROP = 1 THEN PRINT "PASS: tri_pair": GOTO 650
640 PRINT "FAIL: tri_pair": FAILS = FAILS + 1
650 L$ = "|": GOSUB 10000
660 IF DROP = 1 THEN PRINT "PASS: pipe": GOTO 680
670 PRINT "FAIL: pipe": FAILS = FAILS + 1
680 L$ = "||": GOSUB 10000
690 IF DROP = 1 THEN PRINT "PASS: pipes": GOTO 710
700 PRINT "FAIL: pipes": FAILS = FAILS + 1
710 L$ = "| |": GOSUB 10000
720 IF DROP = 1 THEN PRINT "PASS: pipe_gap": GOTO 740
730 PRINT "FAIL: pipe_gap": FAILS = FAILS + 1
740 L$ = "  JOHN   DOE  ": GOSUB 10000
750 IF DROP = 0 THEN GOTO 760 ELSE GOTO 790
760 IF L$ = "JOHN DOE" THEN PRINT "PASS: name": GOTO 800
770 GOTO 790
790 PRINT "FAIL: name": FAILS = FAILS + 1
800 GOSUB 10000
810 IF DROP = 0 THEN GOTO 820 ELSE GOTO 850
820 IF L$ = "JOHN DOE" THEN PRINT "PASS: name_identity": GOTO 860
830 GOTO 850
850 PRINT "FAIL: name_identity": FAILS = FAILS + 1
860 L$ = "|1EG4TE5MK72|": GOSUB 10000
870 IF DROP = 0 THEN GOTO 880 ELSE GOTO 910
880 IF L$ = "1EG4TE5MK72" THEN PRINT "PASS: mbi": GOTO 920
890 GOTO 910
910 PRINT "FAIL: mbi": FAILS = FAILS + 1
920 L$ = CHR$(9) + CHR$(9) + "I10" + CHR$(9): GOSUB 10000
930 IF DROP = 0 THEN GOTO 940 ELSE GOTO 970
940 IF L$ = "I10" THEN PRINT "PASS: icd": GOTO 980
950 GOTO 970
970 PRINT "FAIL: icd": FAILS = FAILS + 1
980 L$ = "__________": GOSUB 10000
990 IF DROP = 1 THEN PRINT "PASS: blank_rule": GOTO 1010
1000 PRINT "FAIL: blank_rule": FAILS = FAILS + 1
1010 L$ = "|99213|": GOSUB 10000
1020 IF DROP = 0 THEN GOTO 1030 ELSE GOTO 1060
1030 IF L$ = "99213" THEN PRINT "PASS: hcpcs": GOTO 1070
1040 GOTO 1060
1060 PRINT "FAIL: hcpcs": FAILS = FAILS + 1
1070 L$ = "99213": GOSUB 10000
1080 IF DROP = 0 THEN GOTO 1090 ELSE GOTO 1120
1090 IF L$ = "99213" THEN PRINT "PASS: hcpcs_plain": GOTO 1130
1100 GOTO 1120
1120 PRINT "FAIL: hcpcs_plain": FAILS = FAILS + 1
1130 L$ = "|08|01|2026|": GOSUB 10000
1140 IF DROP = 0 THEN GOTO 1150 ELSE GOTO 1180
1150 IF L$ = "08|01|2026" THEN PRINT "PASS: dos": GOTO 1190
1160 GOTO 1180
1180 PRINT "FAIL: dos": FAILS = FAILS + 1
1190 L$ = "||NONE||": GOSUB 10000
1200 IF DROP = 0 THEN GOTO 1210 ELSE GOTO 1240
1210 IF L$ = "NONE" THEN PRINT "PASS: none": GOTO 1250
1220 GOTO 1240
1240 PRINT "FAIL: none": FAILS = FAILS + 1
1250 L$ = "A|B": GOSUB 10000
1260 IF DROP = 0 THEN GOTO 1270 ELSE GOTO 1300
1270 IF L$ = "A|B" THEN PRINT "PASS: interior_pipe": GOTO 1310
1280 GOTO 1300
1300 PRINT "FAIL: interior_pipe": FAILS = FAILS + 1
1310 L$ = "O": GOSUB 10000
1320 IF DROP = 0 THEN GOTO 1330 ELSE GOTO 1360
1330 IF L$ = "O" THEN PRINT "PASS: letter_o": GOTO 1370
1340 GOTO 1360
1360 PRINT "FAIL: letter_o": FAILS = FAILS + 1
1370 L$ = "JOHN | DOE": GOSUB 10000
1380 IF DROP = 0 THEN GOTO 1390 ELSE GOTO 1420
1390 IF L$ = "JOHN | DOE" THEN PRINT "PASS: mid_pipe": GOTO 1430
1400 GOTO 1420
1420 PRINT "FAIL: mid_pipe": FAILS = FAILS + 1
1430 L$ = "|----|": GOSUB 10000
1440 IF DROP = 1 THEN PRINT "PASS: boxed_line": GOTO 1460
1450 PRINT "FAIL: boxed_line": FAILS = FAILS + 1
1460 L$ = "|()|": GOSUB 10000
1470 IF DROP = 1 THEN PRINT "PASS: boxed_circle": GOTO 1490
1480 PRINT "FAIL: boxed_circle": FAILS = FAILS + 1
1490 REM ========== SHARED BLOB ==========
1500 GOT$ = ""
1510 L$ = CHR$(13): GOSUB 17000
1520 L$ = "  JOHN   DOE  " + CHR$(13): GOSUB 17000
1530 L$ = "-----": GOSUB 17000
1540 L$ = "|1EG4TE5MK72|": GOSUB 17000
1550 L$ = CHR$(9) + CHR$(9) + "I10" + CHR$(9): GOSUB 17000
1560 L$ = "__________": GOSUB 17000
1570 L$ = "|99213|": GOSUB 17000
1580 L$ = "()": GOSUB 17000
1590 L$ = "^": GOSUB 17000
1600 L$ = "|08|01|2026|": GOSUB 17000
1610 L$ = "||NONE||": GOSUB 17000
1620 L$ = "A|B": GOSUB 17000
1630 L$ = "O": GOSUB 17000
1640 REF$ = "JOHN DOE"
1650 REF$ = REF$ + CHR$(10) + "1EG4TE5MK72"
1660 REF$ = REF$ + CHR$(10) + "I10"
1670 REF$ = REF$ + CHR$(10) + "99213"
1680 REF$ = REF$ + CHR$(10) + "08|01|2026"
1690 REF$ = REF$ + CHR$(10) + "NONE"
1700 REF$ = REF$ + CHR$(10) + "A|B"
1710 REF$ = REF$ + CHR$(10) + "O"
1720 IF GOT$ = REF$ THEN PRINT "PASS: shared_blob": GOTO 1740
1730 PRINT "FAIL: shared_blob": FAILS = FAILS + 1
1740 REM second pass
1750 L$ = GOT$: GOSUB 18000
1760 IF L$ = GOT$ THEN PRINT "PASS: second_pass": GOTO 1780
1770 PRINT "FAIL: second_pass": FAILS = FAILS + 1
1780 REM naive ends-only is the miss
1790 NAV$ = ""
1800 L$ = CHR$(13): GOSUB 19000
1810 L$ = "  JOHN   DOE  " + CHR$(13): GOSUB 19000
1820 L$ = "-----": GOSUB 19000
1830 L$ = "|1EG4TE5MK72|": GOSUB 19000
1840 L$ = CHR$(9) + CHR$(9) + "I10" + CHR$(9): GOSUB 19000
1850 L$ = "__________": GOSUB 19000
1860 L$ = "|99213|": GOSUB 19000
1870 L$ = "()": GOSUB 19000
1880 L$ = "^": GOSUB 19000
1890 L$ = "|08|01|2026|": GOSUB 19000
1900 L$ = "||NONE||": GOSUB 19000
1910 L$ = "A|B": GOSUB 19000
1920 L$ = "O": GOSUB 19000
1930 GOSUB 20000
1940 IF FAILS = 0 THEN GOTO 1950 ELSE GOTO 1980
1950 IF GOT$ = REF$ THEN PRINT "SKILL_VALUE: 0.000000": GOTO 1990
1960 GOTO 1980
1980 PRINT "SKILL_VALUE: UNCLOSED": FAILS = FAILS + 1
1990 IF FAILS = 0 THEN PRINT "SUMMARY: ALL PASS" ELSE PRINT "SUMMARY: FAILS="; FAILS
2000 END
8000 REM ========== GOSUB BOX ==========
8010 B1$ = "+---+"
8020 B2$ = "|   |"
8030 B3$ = "+---+"
8040 RETURN
8100 REM ========== GOSUB LINE ==========
8110 H1$ = "-----"
8120 RETURN
8200 REM ========== GOSUB CIRCLE ==========
8210 C1$ = "  o  "
8220 C2$ = " o o "
8230 C3$ = "  o  "
8240 RETURN
8300 REM ========== GOSUB TRIANGLE ==========
8310 D1$ = "  ^  "
8320 D2$ = " / \ "
8330 D3$ = "-----"
8340 RETURN
10000 REM ========== GOSUB CLEAN_LINE ==========
10010 DROP = 0
10020 GOSUB 11000
10030 IF DROP = 1 THEN RETURN
10040 GOSUB 12000
10050 IF DROP = 1 THEN RETURN
10060 GOSUB 13000
10070 IF DROP = 1 THEN RETURN
10080 GOSUB 14000
10090 IF DROP = 1 THEN RETURN
10100 GOSUB 15000
10110 RETURN
11000 REM ========== COLLAPSE ==========
11010 S$ = ""
11020 I = 1
11030 P = 0
11040 K = 0
11050 IF MID$(L$, I, 1) = "" THEN GOTO 11220
11060 T$ = MID$(L$, I, 1)
11070 IF T$ = CHR$(9) THEN T$ = " "
11080 IF T$ = CHR$(13) THEN GOTO 11200
11090 IF T$ = CHR$(12) THEN GOTO 11200
11100 IF T$ = " " THEN GOTO 11150
11110 S$ = S$ + T$
11120 P = 0
11130 K = 1
11140 GOTO 11200
11150 IF K = 0 THEN GOTO 11200
11160 IF P = 1 THEN GOTO 11200
11170 S$ = S$ + " "
11180 P = 1
11200 I = I + 1
11210 GOTO 11050
11220 IF P = 1 THEN GOSUB 16000
11230 L$ = S$
11240 IF L$ = "" THEN DROP = 1
11250 RETURN
12000 REM ========== BOX EDGE ==========
12010 IF L$ = "" THEN DROP = 1: RETURN
12020 T$ = MID$(L$, 1, 1)
12030 IF T$ = " " THEN L$ = MID$(L$, 2): GOTO 12010
12040 IF T$ = "|" THEN L$ = MID$(L$, 2): GOTO 12010
12050 GOSUB 12100
12060 IF E$ = " " THEN GOSUB 12200: GOTO 12010
12070 IF E$ = "|" THEN GOSUB 12200: GOTO 12010
12080 IF L$ = "" THEN DROP = 1
12090 RETURN
12100 REM last char of L$ into E$
12110 E$ = ""
12120 I = 1
12130 IF MID$(L$, I, 1) = "" THEN RETURN
12140 E$ = MID$(L$, I, 1)
12150 I = I + 1
12160 GOTO 12130
12200 REM drop last char of L$
12210 U$ = ""
12220 I = 1
12230 J = 0
12240 IF MID$(L$, I, 1) = "" THEN GOTO 12280
12250 J = I
12260 I = I + 1
12270 GOTO 12240
12280 I = 1
12290 IF I = J THEN GOTO 12330
12300 U$ = U$ + MID$(L$, I, 1)
12310 I = I + 1
12320 GOTO 12290
12330 L$ = U$
12340 RETURN
13000 REM ========== LINE RULE ==========
13010 BAD = 0
13020 I = 1
13030 IF MID$(L$, I, 1) = "" THEN GOTO 13120
13040 T$ = MID$(L$, I, 1)
13050 IF T$ = " " THEN GOTO 13100
13060 IF T$ = "-" THEN GOTO 13100
13070 IF T$ = "_" THEN GOTO 13100
13080 IF T$ = "=" THEN GOTO 13100
13090 IF T$ = "+" THEN GOTO 13100
13095 IF T$ = "~" THEN GOTO 13100
13096 BAD = 1
13100 I = I + 1
13110 GOTO 13030
13120 IF BAD = 0 THEN DROP = 1
13130 RETURN
14000 REM ========== CIRCLE MARK ==========
14010 BAD = 0
14020 I = 1
14030 IF MID$(L$, I, 1) = "" THEN GOTO 14090
14040 T$ = MID$(L$, I, 1)
14050 IF T$ = " " THEN GOTO 14070
14060 IF T$ = "(" THEN GOTO 14070
14065 IF T$ = ")" THEN GOTO 14070
14066 BAD = 1
14070 I = I + 1
14080 GOTO 14030
14090 IF BAD = 0 THEN DROP = 1
14100 RETURN
15000 REM ========== TRIANGLE MARK ==========
15010 BAD = 0
15020 I = 1
15030 IF MID$(L$, I, 1) = "" THEN GOTO 15090
15040 T$ = MID$(L$, I, 1)
15050 IF T$ = " " THEN GOTO 15070
15060 IF T$ = "^" THEN GOTO 15070
15065 IF T$ = "/" THEN GOTO 15070
15066 IF T$ = "\" THEN GOTO 15070
15067 BAD = 1
15070 I = I + 1
15080 GOTO 15030
15090 IF BAD = 0 THEN DROP = 1
15100 RETURN
16000 REM chop one trailing space from S$
16010 U$ = ""
16020 I = 1
16030 J = 0
16040 IF MID$(S$, I, 1) = "" THEN GOTO 16080
16050 J = I
16060 I = I + 1
16070 GOTO 16040
16080 I = 1
16090 IF I = J THEN GOTO 16130
16100 U$ = U$ + MID$(S$, I, 1)
16110 I = I + 1
16120 GOTO 16090
16130 S$ = U$
16140 RETURN
17000 REM clean L$ and append to GOT$ when kept
17010 GOSUB 10000
17020 IF DROP = 1 THEN RETURN
17030 IF GOT$ = "" THEN GOT$ = L$: RETURN
17040 GOT$ = GOT$ + CHR$(10) + L$
17050 RETURN
18000 REM second pass: clean a joined blob held in L$
18010 SRC$ = L$
18020 OUT$ = ""
18030 CUR$ = ""
18040 N = 1
18050 BRK$ = MID$(SRC$, N, 1)
18060 IF BRK$ = "" THEN GOTO 18120
18070 IF BRK$ = CHR$(10) THEN GOTO 18120
18080 CUR$ = CUR$ + BRK$
18090 N = N + 1
18100 GOTO 18050
18120 L$ = CUR$
18130 GOSUB 10000
18140 IF DROP = 1 THEN GOTO 18170
18150 IF OUT$ = "" THEN OUT$ = L$ ELSE OUT$ = OUT$ + CHR$(10) + L$
18170 IF BRK$ = "" THEN GOTO 18210
18180 N = N + 1
18190 CUR$ = ""
18200 GOTO 18050
18210 L$ = OUT$
18220 RETURN
19000 REM naive trim of spaces only; append to NAV$
19010 IF MID$(L$, 1, 1) = " " THEN L$ = MID$(L$, 2): GOTO 19010
19020 IF L$ = "" THEN RETURN
19030 GOSUB 12100
19040 IF E$ = " " THEN GOSUB 12200: GOTO 19020
19050 IF L$ = "" THEN RETURN
19060 IF NAV$ = "" THEN NAV$ = L$: RETURN
19070 NAV$ = NAV$ + CHR$(10) + L$
19080 RETURN
20000 REM floor of NAV$ against REF$. M matched, R reference length.
20010 M = 0
20020 R = 0
20030 I = 1
20040 IF MID$(REF$, I, 1) = "" THEN GOTO 20090
20050 R = R + 1
20060 IF MID$(NAV$, I, 1) = MID$(REF$, I, 1) THEN M = M + 1
20070 I = I + 1
20080 GOTO 20040
20090 IF R = 0 THEN PRINT "BEFORE_FLOOR: UNCLOSED": FAILS = FAILS + 1: RETURN
20100 P = ABS(M - R) / R * 100
20110 W = INT(P * 1000000)
20120 P = W / 1000000
20130 PRINT "BEFORE_FLOOR: "; P
20140 IF P = 0 THEN PRINT "FAIL: before_was_not_worse": FAILS = FAILS + 1
20150 RETURN
