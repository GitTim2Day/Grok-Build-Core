10 REM Timothy Norman OCR streamline clean. Twin of ocr_streamline.py.
20 REM GOSUB / RETURN. IF / THEN / ELSE. Fail-closed. No angle-bracket compares.
30 REM Commands: BOX, LINE, CIRCLE, TRIANGLE. No 0/O guess. No fitted cutoffs.
40 REM Skill value = GOSUB accuracy floor. Zero error prints 0.000000.
50 FAILS = 0
60 REM ========== GEOMETRY COMMANDS ==========
70 GOSUB 8000
80 IF B1$ = "+---+" THEN GOTO 90 ELSE GOTO 120
90 IF B2$ = "|   |" THEN GOTO 100 ELSE GOTO 120
100 IF B3$ = "+---+" THEN PRINT "PASS: box": GOTO 130
110 GOTO 120
120 PRINT "FAIL: box": FAILS = FAILS + 1
130 GOSUB 8100
140 IF H1$ = "-----" THEN PRINT "PASS: line": GOTO 160
150 PRINT "FAIL: line": FAILS = FAILS + 1
160 GOSUB 8200
170 IF C1$ = "  o  " THEN GOTO 180 ELSE GOTO 210
180 IF C2$ = " o o " THEN GOTO 190 ELSE GOTO 210
190 IF C3$ = "  o  " THEN PRINT "PASS: circle": GOTO 220
200 GOTO 210
210 PRINT "FAIL: circle": FAILS = FAILS + 1
220 GOSUB 8300
230 IF D1$ = "  ^  " THEN GOTO 240 ELSE GOTO 270
240 IF D2$ = " / \ " THEN GOTO 250 ELSE GOTO 270
250 IF D3$ = "-----" THEN PRINT "PASS: triangle": GOTO 280
260 GOTO 270
270 PRINT "FAIL: triangle": FAILS = FAILS + 1
280 REM ========== LINE CASES ==========
290 L$ = "": GOSUB 10000
300 IF DROP = 1 THEN PRINT "PASS: empty": GOTO 320
310 PRINT "FAIL: empty": FAILS = FAILS + 1
320 L$ = "   ": GOSUB 10000
330 IF DROP = 1 THEN PRINT "PASS: spaces": GOTO 350
340 PRINT "FAIL: spaces": FAILS = FAILS + 1
350 L$ = "-----": GOSUB 10000
360 IF DROP = 1 THEN PRINT "PASS: hline": GOTO 380
370 PRINT "FAIL: hline": FAILS = FAILS + 1
