3000 REM Two passes of m*x^n+b. They must agree.
3010 GOSUB 3100
3020 S1=RN : S2=RD
3030 GOSUB 3100
3040 IF RN<>S1 OR RD<>S2 THEN VF=0 ELSE VF=1
3050 RETURN
3100 PN=1 : PD=1
3110 FOR I=1 TO NN
3120 PN=PN*XN : PD=PD*XD
3130 NEXT I
3140 RN=MN*PN*BD+BN*MD*PD
3150 RD=MD*PD*BD
3160 GOSUB 3500
3170 RETURN
3500 IF RD<0 THEN RN=-RN : RD=-RD
3510 AN=RN : IF AN<0 THEN AN=-AN
3520 AD=RD
3530 IF AN<AD THEN T=AN : AN=AD : AD=T
3540 IF AD=0 THEN RETURN
3550 Q=INT(AN/AD) : T=AN-Q*AD : AN=AD : AD=T
3560 IF AD<>0 THEN GOTO 3530
3570 RN=RN/AN : RD=RD/AN
3580 RETURN
