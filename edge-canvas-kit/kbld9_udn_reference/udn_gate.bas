6680 PHI=65536/P
6690 NEWLO=(NL*P)-65536*INT((NL*P)/65536)
6700 CARRY=INT(NL/PHI)
6710 NEWH=(NH*P)-65536*INT((NH*P)/65536)+CARRY
6720 Y=NEWH*65536+NEWLO
6730 RETURN
