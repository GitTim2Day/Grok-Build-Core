6600 REM SHR32 X by N -> Y, N is 0..31. Halves only.
6610 IF N>=16 THEN NH=INT(X/65536) : NS=N-16 : P=P2(NS) : Y=INT(NH/P) : RETURN
6620 NL=X-65536*INT(X/65536) : NH=INT(X/65536) : P=P2(N)
6630 MASK=P-1 : LOW=INT(NL/P) : HIB=(NH AND MASK) : HIB=HIB*(65536/P)
6640 Y=INT(NH/P)*65536+LOW+HIB : RETURN
6650 REM SHL32 X by N -> Y. Products stay inside 2^31.
6660 IF N>=16 THEN NL=X-65536*INT(X/65536) : NS=N-16 : P=P2(NS) : SH=(NL*P)-65536*INT((NL*P)/65536) : Y=SH*65536 : RETURN
