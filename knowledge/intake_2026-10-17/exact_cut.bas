10 REM exact_cut.bas — sig-digit cut toward zero. Additive 2026-10-17. Not cut8.
20 REM Numerator is a digit string. Denom is an integer 1..100000000000000. Sig 1..40.
30 REM Sign is NG% after the cut. Zero stays 0. Outside the band: UNKNOWN.
40 REM Long literals only. Bywater 3.20b rejects D+00 in DATA.
50 DM% = 255: ML% = DM% - 1: MZ% = 30: MD# = 100000000000000#: MS% = 40: MX% = MZ% + MS%
60 OPEN "O", #1, "EXCUT.OUT"
70 READ NC%
80 PS% = 0: FL% = 0
90 FOR CT% = 1 TO NC%
100 READ NU$, DN#, NS%, NG%, EX$
110 GOSUB 1000
120 IF OT$ = EX$ THEN PS% = PS% + 1: PRINT #1, "PASS "; CT%; " "; OT$
130 IF OT$ <> EX$ THEN FL% = FL% + 1: PRINT #1, "FAIL "; CT%; " "; OT$; " "; EX$
140 NEXT CT%
150 PRINT #1, "TOTAL "; NC%; " FAILS "; FL%
160 PRINT "TOTAL "; NC%; " FAILS "; FL%
170 CLOSE #1
180 SYSTEM
1000 REM in NU$ DN# NS% NG%   out OT$
1010 QU$ = "": RM# = 0: ER% = 0: OT$ = ""
1020 IF DN# > MD# THEN ER% = 1
1030 IF DN# < 1 THEN ER% = 1
1040 IF NS% < 1 THEN ER% = 1
1050 IF NS% > MS% THEN ER% = 1
1060 IF NU$ = "" THEN ER% = 1
1070 IF LEN(NU$) > ML% THEN ER% = 1
1080 IF ER% = 1 THEN OT$ = "UNKNOWN": RETURN
1090 FOR PX% = 1 TO LEN(NU$)
1100 DG% = ASC(MID$(NU$, PX%, 1)) - &H30
1110 IF DG% < 0 THEN ER% = 1: DG% = 0
1120 IF DG% > 9 THEN ER% = 1: DG% = 0
1130 RM# = RM# * 10 + DG%
1140 GOSUB 2000
1150 AP% = 1
1160 IF QD% = 0 THEN IF QU$ = "" THEN AP% = 0
1170 IF AP% = 1 THEN QU$ = QU$ + CHR$(&H30 + QD%)
1180 NEXT PX%
1190 IF ER% = 1 THEN OT$ = "UNKNOWN": RETURN
1200 IL% = LEN(QU$)
1210 IF IL% = 0 THEN IF RM# = 0 THEN OT$ = "0": GOTO 1400
1220 IF IL% < NS% THEN GOTO 1260
1230 OT$ = LEFT$(QU$, NS%) + STRING$(IL% - NS%, &H30)
1240 GOTO 1400
1260 FD$ = "": FZ% = 0: SC% = IL%: NF% = 0
1270 IF IL% > 0 THEN NF% = 1
1280 FOR PX% = 1 TO MX%
1290 IF SC% < NS% THEN GOSUB 2100
1300 NEXT PX%
1310 IF SC% < NS% THEN OT$ = "UNKNOWN": RETURN
1320 IF IL% > 0 THEN OT$ = QU$ + "." + FD$
1330 IF IL% = 0 THEN OT$ = "0." + STRING$(FZ%, &H30) + FD$
1400 IF NG% <> 1 THEN RETURN
1410 IF OT$ = "0" THEN RETURN
1420 IF LEN(OT$) + 1 > ML% THEN OT$ = "UNKNOWN": RETURN
1430 OT$ = "-" + OT$
1440 RETURN
2000 QD% = INT(RM# / DN#)
2010 IF QD% * DN# > RM# THEN QD% = QD% - 1
2020 IF RM# - QD% * DN# >= DN# THEN QD% = QD% + 1
2030 RM# = RM# - QD% * DN#
2040 RETURN
2100 RM# = RM# * 10
2110 GOSUB 2000
2120 IF NF% = 1 THEN GOTO 2150
2130 IF QD% = 0 THEN FZ% = FZ% + 1: RETURN
2140 NF% = 1
2150 FD$ = FD$ + CHR$(&H30 + QD%): SC% = SC% + 1
2160 RETURN
